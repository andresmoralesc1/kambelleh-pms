# =============================================
# Kambelleh PMS - Environment Variables
# =============================================
# Copy this file to .env and fill in the values

# Database
POSTGRES_PASSWORD=change_me_in_production

# JWT Secrets - generate with: openssl rand -base64 64
JWT_SECRET=your_jwt_secret_here_min_32_chars
JWT_REFRESH_SECRET=your_refresh_secret_here_min_32_chars

# Stripe - get from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here

# Email (Resend) - get from https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# Optional: LetsEncrypt will auto-provision via certbot
# Leave ssl section empty initially, certbot will fill after first run
# Or manually place certs at ./ssl/fullchain.pem and ./ssl/privkey.pem