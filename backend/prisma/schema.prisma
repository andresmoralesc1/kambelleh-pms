// Kambelleh PMS - Prisma Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ================== USER / STAFF ==================

enum Role {
  ADMIN
  MANAGER
  RECEPCIONIST
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  role         Role     @default(RECEPCIONIST)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  reservationsCreated Reservation[] @relation("CreatedBy")
  refreshTokens RefreshToken[]
  activityLogs ActivityLog[]
  cleaningLogs CleaningLog[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

// ================== ROOMS ==================

enum RoomType {
  PRIVATE
  SHARED
  DORM
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
}

enum CleaningStatus {
  CLEANED
  NEEDS_CLEANING
  IN_CLEANING
  MAINTENANCE
}

model Room {
  id            String        @id @default(uuid())
  number        String        @unique
  name          String
  type          RoomType      @default(PRIVATE)
  capacity      Int
  pricePerNight Decimal       @map("price_per_night") @db.Decimal(10, 2)
  status        RoomStatus    @default(AVAILABLE)
  cleaningStatus CleaningStatus @default(CLEANED) @map("cleaning_status")
  amenities     String[]      @default([])
  floor         Int           @default(1)
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  reservations Reservation[]
  blockedDates BlockedDate[]
  cleaningLogs CleaningLog[]

  @@map("rooms")
}

// ================== GUESTS ==================

model Guest {
  id              String   @id @default(uuid())
  name            String
  email           String?
  phone           String?
  documentType    String?  @map("document_type")
  documentNumber  String?  @map("document_number")
  nationality     String?
  birthDate       DateTime? @map("birth_date") @db.Date
  notes           String?
  vip             Boolean   @default(false) @map("vip")
  blacklist       Boolean   @default(false) @map("blacklist")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  reservations Reservation[]
  internalNotes InternalNote[]

  @@index([email])
  @@index([phone])
  @@map("guests")
}

// ================== RESERVATIONS ==================

enum ReservationStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
}

model Reservation {
  id             String             @id @default(uuid())
  guestId        String             @map("guest_id")
  roomId         String             @map("room_id")
  checkIn        DateTime           @db.Date
  checkOut       DateTime           @db.Date
  status         ReservationStatus  @default(PENDING)
  totalAmount    Decimal            @map("total_amount") @db.Decimal(10, 2)
  stripePaymentId String?           @map("stripe_payment_id")
  adults         Int                @default(1)
  children       Int                @default(0)
  specialRequests String?           @map("special_requests")
  source         String             @default("DIRECT") @map("source")
  cancellationReason String?           @map("cancellation_reason")
  createdById    String?            @map("created_by_id")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  guest      Guest      @relation(fields: [guestId], references: [id])
  room       Room       @relation(fields: [roomId], references: [id])
  createdBy  User?      @relation("CreatedBy", fields: [createdById], references: [id])
  payments   Payment[]
  internalNotes InternalNote[]

  @@index([status])
  @@index([checkIn])
  @@index([checkOut])
  @@index([source])
  @@map("reservations")
}

// ================== PAYMENTS ==================

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

model Payment {
  id             String        @id @default(uuid())
  reservationId  String        @map("reservation_id")
  amount         Decimal       @db.Decimal(10, 2)
  currency       String        @default("eur")
  status         PaymentStatus @default(PENDING)
  stripeChargeId String?       @map("stripe_charge_id")
  method         String?
  notes          String?
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  reservation Reservation @relation(fields: [reservationId], references: [id])

  @@index([status])
  @@index([createdAt])
  @@map("payments")
}

// ================== BLOCKED DATES ==================

enum BlockReason {
  MAINTENANCE
  BOOKING
  OTHER
}

model BlockedDate {
  id      String     @id @default(uuid())
  roomId  String     @map("room_id")
  date    DateTime   @db.Date
  reason  BlockReason @default(BOOKING)
  note    String?
  createdAt DateTime @default(now()) @map("created_at")

  room Room @relation(fields: [roomId], references: [id])

  @@unique([roomId, date])
  @@map("blocked_dates")
}

// ================== CLEANING ==================

model CleaningLog {
  id          String        @id @default(uuid())
  roomId      String        @map("room_id")
  staffId     String?       @map("staff_id")
  performedBy String        @map("performed_by")
  status      CleaningStatus
  notes       String?
  createdAt   DateTime      @default(now()) @map("created_at")
  completedAt DateTime?     @map("completed_at")

  room  Room  @relation(fields: [roomId], references: [id])
  staff User? @relation(fields: [staffId], references: [id])

  @@index([roomId])
  @@index([staffId])
  @@index([createdAt])
  @@map("cleaning_logs")
}

// ================== INTERNAL NOTES ==================

model InternalNote {
  id            String   @id @default(uuid())
  content       String
  authorName    String   @map("author_name")
  reservationId String?  @map("reservation_id")
  guestId       String?  @map("guest_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  reservation Reservation? @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  guest       Guest?       @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@index([guestId])
  @@index([reservationId])
  @@map("internal_notes")
}

// ================== CHANNEL CONNECTIONS ==================

enum Channel {
  AIRBNB
  BOOKING
  EXPEDIA
}

model ChannelConnection {
  id           String    @id @default(uuid())
  channel      Channel
  accessToken  String?   @map("access_token")
  refreshToken String?   @map("refresh_token")
  expiresAt    DateTime? @map("expires_at")
  lastSync     DateTime? @map("last_sync")
  isActive     Boolean   @default(false) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([channel])
  @@map("channel_connections")
}

// ================== SETTINGS ==================

model Setting {
  id        String   @id @default(uuid())
  key       String   @unique @map("key")
  value     String   @map("value")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

// ================== ACTIVITY LOG ==================

model ActivityLog {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  action     String
  resource   String
  resourceId String?  @map("resource_id")
  details    Json?
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([resource])
  @@index([createdAt])
  @@map("activity_logs")
}